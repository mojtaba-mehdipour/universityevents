<?xml version="1.0" encoding="utf-8"?>

<!--
    طراحی صفحه اصلی برنامه مدیریت دانشجویان
-->

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- قرارگیری عناصر به صورت عمودی -->


    <!-- فاصله داخلی صفحه -->


    <!-- عنوان برنامه -->
<TextView
android:id="@+id/txtTitle"
android:layout_width="match_parent"
android:layout_height="wrap_content"

android:text="مدیریت دانشجویان"
android:textSize="24sp"
android:textStyle="bold"
android:gravity="center"

android:padding="15dp"/>

    <!-- دکمه باز کردن فرم ثبت دانشجو -->
<Button
android:id="@+id/btnAddStudent"
android:layout_width="match_parent"
android:layout_height="wrap_content"

android:text="ثبت دانشجو"

android:layout_marginTop="20dp"/>

    <!--
        این TextView اطلاعات دانشجو را
        بعد از ثبت نمایش می‌دهد.
    -->
<TextView
android:id="@+id/txtStudentInfo"
android:layout_width="match_parent"
android:layout_height="wrap_content"

android:text="هنوز دانشجویی ثبت نشده است."

android:textSize="18sp"
android:padding="15dp"

android:layout_marginTop="20dp"/>

    </LinearLayout>
